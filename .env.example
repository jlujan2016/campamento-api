# Copiá este archivo como .env y completá los valores reales
# cp .env.example .env   (en Linux/Mac)
# copy .env.example .env  (en Windows)

# ── Base de datos ──────────────────────────────────────────────
DB_USER=campamento
DB_PASSWORD=           # elegí una contraseña segura
DB_NAME=campamento_db
DB_PORT_HOST=5433      # cambiá si 5433 está ocupado en tu máquina

DATABASE_URL=postgres://campamento:TU_PASSWORD@localhost:5433/campamento_db

# ── Servidor ───────────────────────────────────────────────────
APP_PORT=8090          # cambiá si 8090 está ocupado
APP_HOST=0.0.0.0       # usar 127.0.0.1 en producción con tunnel Cloudflare

# ── Seguridad ──────────────────────────────────────────────────
# Generá una clave segura con: openssl rand -hex 32
JWT_SECRET=

# ── CORS ───────────────────────────────────────────────────────
# Desarrollo: URL del frontend separado
# Producción (mismo origen): dejar VACÍO
CORS_ORIGINS=http://localhost:5174

# ── Telegram (opcional) ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=    # obtener de @BotFather en Telegram