# ═══════════════════════════════════════════════════════════════
# CALLATE Y BAILA! — Backend (campamento-api)
# ═══════════════════════════════════════════════════════════════
# Copiá este archivo como .env y completá los valores:
#   Windows: copy .env.example .env
#   Linux:   cp .env.example .env
#
# NUNCA subas el .env real a Git — está en .gitignore
# ═══════════════════════════════════════════════════════════════

# ── BASE DE DATOS ───────────────────────────────────────────────
# Credenciales del contenedor Docker de PostgreSQL
# Deben coincidir con lo que está en docker-compose.yml
DB_USER=campamento
DB_PASSWORD=           # elegí una contraseña segura, sin espacios

DB_NAME=campamento_db

# Puerto que Docker expone en tu máquina
# Cambiá si ya tenés otro PostgreSQL instalado en ese puerto
# Opciones comunes: 5432 (default Postgres), 5433 (alternativo)
DB_PORT_HOST=5433

# URL completa de conexión para SQLx
# Formato: postgres://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_DB
#
# Si Docker corre en la MISMA máquina que el backend:
#   DATABASE_URL=postgres://campamento:PASSWORD@localhost:5433/campamento_db
#
# Si Docker corre en OTRA máquina de la red (ej. otra laptop):
#   DATABASE_URL=postgres://campamento:PASSWORD@192.168.1.XX:5432/campamento_db
#   (usar el puerto interno 5432, no el DB_PORT_HOST)
DATABASE_URL=postgres://campamento:PASSWORD@localhost:5433/campamento_db

# ── SERVIDOR ────────────────────────────────────────────────────
# Puerto donde escucha el backend
# Default: 8090 (elegido para no chocar con puertos comunes)
# Cambiá si ese puerto está ocupado en tu máquina
APP_PORT=8090

# Host donde escucha el servidor
# 0.0.0.0 = acepta conexiones de cualquier IP (desarrollo y producción)
# 127.0.0.1 = solo acepta conexiones locales (más seguro con Cloudflare tunnel)
APP_HOST=0.0.0.0

# ── SEGURIDAD ───────────────────────────────────────────────────
# Clave para firmar los tokens JWT
# IMPORTANTE: debe ser larga, aleatoria y NUNCA cambiarla en producción
# Si la cambiás, todos los usuarios quedan deslogueados (tokens inválidos)
#
# Generá una clave segura con uno de estos comandos:
#   Linux/Mac: openssl rand -hex 32
#   PowerShell: [System.Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET=

# ── CORS ────────────────────────────────────────────────────────
# Orígenes permitidos para hacer requests al backend
# Solo necesario cuando el frontend y backend corren en puertos distintos
#
# Desarrollo (Vite en :5174, backend en :8090):
#   CORS_ORIGINS=http://localhost:5174,http://192.168.1.XX:5174
#
# Producción (mismo origen, todo por :8090):
#   CORS_ORIGINS=        ← dejar VACÍO
#
# Múltiples orígenes separados por coma, sin espacios
CORS_ORIGINS=http://localhost:5174

# ── FRONTEND (modo producción) ──────────────────────────────────
# Ruta a la carpeta dist/ del frontend compilado
# Cuando está definida, Axum sirve el frontend además de la API
# Todo sale por APP_PORT — no se necesita Vite ni CORS
#
# Desarrollo (Vite maneja el frontend):
#   Dejar comentado o vacío
#
# Producción (Axum sirve todo):
#   Windows: FRONTEND_DIST=C:/Users/TU_USUARIO/campamento-web/dist
#   Linux:   FRONTEND_DIST=/home/TU_USUARIO/campamento-web/dist
#   Relativa: FRONTEND_DIST=../campamento-web/dist
#
# FRONTEND_DIST=../campamento-web/dist

# ── TELEGRAM (opcional) ─────────────────────────────────────────
# Token del bot de Telegram para notificaciones
# Si no está definido, las notificaciones se desactivan silenciosamente
#
# Cómo obtenerlo:
#   1. Abrí Telegram y buscá @BotFather
#   2. Enviá /newbot y seguí los pasos
#   3. Copiá el token que te da
#
# TELEGRAM_BOT_TOKEN=